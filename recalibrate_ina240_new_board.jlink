si SWD
device STM32G431KB
speed 4000
connect
h
// Soft reset so ControlApp_Init re-runs CurrentSense_Calibrate(128)
// with DRV disabled on this new board.
r
g
sleep 3000
h
// Identity / vector table
mem32 0x08000000,2
// Live board zero region (previous board used 0x20000044 / 0x20000048)
mem32 0x20000040,8
// Current ELF map layout (ia_zero_v@0x20000054, ib_zero_v@0x20000058)
mem32 0x20000050,8
// Wider scan for mid-rail floats (~1.5..1.7V => 0x3FCxxxxx..0x3FD9xxxx)
mem32 0x20000000,48
// Conversion constants / more .data
mem32 0x200000C0,16
// Control flags region (if this firmware matches local map)
mem8 0x20000400,16
// ADC DMA raw candidates
mem16 0x200006F0,16
g
q
