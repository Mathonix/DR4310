si SWD
device STM32G431KB
speed 4000
connect
r
h
loadfile build\Debug\4310_G431KBT6.hex
r
g
sleep 1200
h
// defaults check
mem32 0x200004b8,24
mem32 0x20000030,1
// current test 0.5A
w1 0x20000010,0x01
w1 0x20000011,0x01
w4 0x20000400,0x3F000000
g
sleep 500
h
mem32 0x200004b8,24
g
sleep 500
h
mem32 0x200004b8,24
// disable
w1 0x20000011,0x00
w1 0x20000010,0x00
w4 0x20000400,0x00000000
g
q
