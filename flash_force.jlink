si SWD
device STM32G431KB
speed 1000
connect
halt
w4 0x4002104C, 0x00000101
w4 0x40020008, 0x00000000
w4 0x4002000C, 0x00000000
w4 0x40012408, 0x00000000
w4 0x40012400, 0x00000000
SetPC 0x08000000
SetSP 0x20008000
loadfile build\Debug\4310_G431KBT6.hex
verifybin build\Debug\4310_G431KBT6.bin, 0x08000000
r
g
q
