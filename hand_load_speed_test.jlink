si SWD
device STM32G431KB
speed 4000
connect
r
h
loadfile build\Debug\4310_G431KBT6.hex
r
g
sleep 1500
h
// speed mode only
w1 0x20000010,0x01
w1 0x20000011,0x00
w1 0x200003f4,0x00
w1 0x200003f5,0x00
w1 0x200003f6,0x00
w1 0x200003f7,0x00
w4 0x200003f8,0x00000000
g
sleep 1000
h
// ========== 100 rpm empty ==========
// 10.471976 rad/s
w4 0x200003f8,0x41278D36
g
sleep 3000
h
mem32 0x20000418,20
// *** HAND PRESS 100 rpm ~4s ***
g
sleep 4000
h
mem32 0x20000418,20
// ========== 300 rpm empty ==========
// 31.415927
w4 0x200003f8,0x41FB53D1
g
sleep 3000
h
mem32 0x20000418,20
// *** HAND PRESS 300 rpm ~4s ***
g
sleep 4000
h
mem32 0x20000418,20
// ========== 500 rpm empty ==========
// 52.359878
w4 0x200003f8,0x42517084
g
sleep 3500
h
mem32 0x20000418,20
// *** HAND PRESS 500 rpm ~4s ***
g
sleep 4000
h
mem32 0x20000418,20
// stop
w4 0x200003f8,0x00000000
g
sleep 2000
h
mem32 0x20000418,12
w1 0x20000010,0x00
g
q
