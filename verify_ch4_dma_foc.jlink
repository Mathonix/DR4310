si SWD
device STM32G431KB
speed 4000
connect
r
h
loadfile build\Debug\4310_G431KBT6.hex
r
g
sleep 1200
h
// foc @ from nm
mem32 0x200004b4,24
mem16 0x2000067c,4
mem8 0x20000683,1
// current test 0.5A
w1 0x20000010,0x01
w1 0x20000011,0x01
w4 0x2000040c,0x3F000000
g
sleep 500
h
mem32 0x200004b4,24
mem16 0x2000067c,4
g
sleep 500
h
mem32 0x200004b4,24
mem16 0x2000067c,4
// disable
w1 0x20000011,0x00
w1 0x20000010,0x00
w4 0x2000040c,0x00000000
g
q

