si SWD
device STM32G431KB
speed 1000
connect
h

/* control flags and current-test refs */
mem8 0x200003f0,8
mem32 0x200003f8,10

/* CurrentSense object: adc/dma ptrs, DMA buffer, zero volts, flags, seq, callback */
mem32 0x20000484,10
mem16 0x2000048c,4

/* FocController object: FOCState, PI state, last current, limits */
mem32 0x200004b8,54

/* MotionController + MotorIdentifier status */
mem32 0x20000590,18
mem32 0x200005d4,23

/* telemetry and global CurrentSense pointer */
mem32 0x2000042c,22
mem32 0x200006c8,1

g
q
