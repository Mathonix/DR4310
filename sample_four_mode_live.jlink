si SWD
device STM32G431KB
speed 4000
connect
// sample isr + loop + mode + bus + pos twice, 200ms apart
mem32 0x20000470,4
mem32 0x20000450,4
sleep 200
mem32 0x20000470,4
mem32 0x20000450,4
// foc isr_count / overrun / sample_fault near end of FOCState
// FOCState floats first ~13*4=52, then enabled... dump from 0x200004E8+0x30
mem32 0x20000518,8
sleep 200
mem32 0x20000518,8
q
