si SWD
device STM32G431KB
speed 4000
connect
// Ensure CPU is halted before reset
h
// Soft reset: ControlApp_Init() re-runs CurrentSense_Calibrate(128)
// with DRV disabled, so motor is off during zero sampling.
r
g
// Wait for init + 128-sample software calibration + StartHw
sleep 3000
h
// Live board layout (observed): zeros near 0x20000044
mem32 0x20000040,8
// Current ELF map layout: ia_zero_v@0x20000054 ib_zero_v@0x20000058
mem32 0x20000050,8
// Wider scan for mid-rail floats (~1.5..1.7 => 0x3FCxxxxx..0x3FD9xxxx)
mem32 0x20000000,48
// Control enable flags (ELF map) — expect disabled after boot
mem8 0x20000400,12
// Vector / identity check
mem32 0x08000000,2
g
q
