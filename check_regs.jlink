si SWD
device STM32G431KB
speed 1000
connect
halt
// ADC1 CR, CFGR, CFGR2, SMPR1, SQR1, DR
mem32 0x50000000,8
mem32 0x50000030,4
// DMA1 Channel1 CCR, CNDTR, CPAR, CMAR
mem32 0x40020008,4
// DMAMUX C0CR
mem32 0x40020800,1
// TIM1 CR1, CR2, SMCR, DIER, SR, EGR, CCMR1, CCMR2, CCER, CNT, PSC, ARR
mem32 0x40012C00,12
// TIM1 CCR1-4 BDTR
mem32 0x40012C34,5
// GPIOF MODER ODR
mem32 0x48001400,1
mem32 0x48001414,1
// unique string search in flash for BUS_OK_SETTLE
mem32 0x08008d00,4
g
q
