si SWD
device STM32G431KB
speed 4000
connect
// software counters
mem32 0x200003A8,4
mem32 0x200003D0,6
// FDCAN1 CCCR @0x18, NBTP @0x1C, ECR @0x40, PSR @0x44
mem32 0x40006418,2
mem32 0x40006440,2
// TXBC/TXFQS/TXBRP/TXBAR around 0xC0
mem32 0x400064C0,8
// TXEFS
mem32 0x400064F0,2
// IR
mem32 0x40006450,2
q
