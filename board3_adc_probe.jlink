si SWD
device STM32G431KB
speed 4000
connect
h
// Read ADC1 peripheral (base 0x50000000)
// DR at +0x40, JSQR etc. Also read common regs.
mem32 0x50000000,20
// ADC1 data register
mem32 0x50000040,1
// DMA1 channel1 registers (base 0x40020008 for Ch1 on G4? DMA1 0x40020000)
// G4 DMA1: 0x40020000, channel1 CCR@0x08 CNDTR@0x0C CPAR@0x10 CMAR@0x14
mem32 0x40020000,12
// Dump RAM around likely sample/telemetry for ia/ib floats near zero current
mem32 0x20000480,64
mem32 0x20000580,64
// Re-read zero pair
mem32 0x20000050,6
// Flash vector
mem32 0x08000000,2
g
q
