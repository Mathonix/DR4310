si SWD
device STM32G431KB
speed 4000
connect
// can_test_status, tx_count, rx_count, error, rx_id
mem32 0x200003A8,8
// last_tick, rx_dlc, protocol fields, tec/rec
mem32 0x200003C8,10
// control mode/cmd
mem8 0x200003FC,1
mem8 0x200003E8,4
// isr/loop still running?
mem32 0x20000470,4
sleep 500
mem32 0x200003AC,1
mem32 0x20000470,2
q
