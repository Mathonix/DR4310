si SWD
device STM32G431KB
speed 1000
connect
halt
// mode flags
mem8 0x20000010,1
mem8 0x2000040c,8
mem32 0x2000041c,1
// zero offsets
mem32 0x20000060,2
// arm gate
mem8 0x200004f8,4
// telemetry 22 words
mem32 0x20000440,22
// foc state
mem32 0x20000504,28
// last_current
mem32 0x200005a8,8
// adc dma raw
mem16 0x200006d4,4
// GPIOF ODR DRV_ENABLE PF0
mem32 0x48001414,1
// TIM1 CCR1-4
mem32 0x40012C34,4
g
q
