si SWD
device STM32G431KB
speed 4000
connect
r
h
// Already flashed industrial FOC image; re-load to be sure
loadfile build\Debug\4310_G431KBT6.hex
r
g
sleep 1500
h
// Disable all modes first
w1 0x20000010,0x01
w1 0x20000011,0x00
w1 0x200003f0,0x00
w1 0x200003f1,0x00
w1 0x200003f2,0x00
w1 0x200003f3,0x00
w4 0x200003fc,0x00000000
// Conservative PI for first step (L may be overestimated)
// Kp=12.0 = 0x41400000, Ki=1500 = 0x44BB8000, Vlim=6.4 = 0x40CCCCCD
w4 0x20000024,0x41400000
w4 0x20000028,0x44BB8000
w4 0x2000002c,0x40CCCCCD
// max_mod=0.60, decoupling on
w4 0x20000034,0x3F19999A
w1 0x20000404,0x01
// Enable current test, iq=0.20A = 0x3E4CCCCD
w1 0x20000011,0x01
w4 0x200003fc,0x3E4CCCCD
g
sleep 2000
h
// Snapshot @0.2A  telemetry + foc
mem32 0x20000414,20
mem32 0x200004ac,20
mem8 0x20000010,2
mem8 0x200003f0,4
// Step to 0.50A = 0x3F000000
w4 0x200003fc,0x3F000000
g
sleep 2500
h
mem32 0x20000414,20
mem32 0x200004ac,20
// Apply identified PI: Kp=39.35=0x421D6739 Ki=3935=0x4575F14A
w4 0x20000024,0x421D6739
w4 0x20000028,0x4575F14A
// Keep iq=0.5A
g
sleep 2000
h
mem32 0x20000414,20
mem32 0x200004ac,20
mem32 0x20000024,3
// Step to 0A
w4 0x200003fc,0x00000000
g
sleep 1000
h
mem32 0x20000414,12
mem32 0x200004ac,12
// Disable
w1 0x20000011,0x00
w1 0x20000010,0x00
w1 0x200003f3,0x00
g
q
