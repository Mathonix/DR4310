{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["w3c-web-usb", "w3c-web-serial"],
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src/client.ts", "src/protocol.ts", "src/chart.ts", "src/serial.ts", "src/serial-worker.ts", "src/pcan.ts"]
}
