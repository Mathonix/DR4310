si SWD
device STM32G431KB
speed 4000
connect
r
h
loadfile build\Debug\4310_G431KBT6.hex
verifybin build\Debug\4310_G431KBT6.bin,0x08000000
r
g
sleep 2000
h
// confirm idle mode=0, armed
mem8 0x20000400,8
mem8 0x200004FE,1
mem32 0x2000043C,12
// open-loop first: mode openloop flag + 300rpm mech ref
// control_mode_cmd=0, open_loop_enable=1, enable=1, vel_ref=31.4159
w1 0x20000400,0x00
w1 0x20000401,0x01
w1 0x20000402,0x01
w1 0x20000403,0x00
w1 0x20000407,0x00
w4 0x20000408,0x41FB53D1
// open_loop mod max 0.12 (higher for low bus)
w4 0x20000024,0x3DF5C28F
g
sleep 3000
h
mem32 0x2000043C,22
// then calibrate
w1 0x20000400,0x0D
w1 0x20000401,0x01
w1 0x20000402,0x00
w1 0x20000407,0x01
w4 0x20000408,0x00000000
g
sleep 18000
h
mem8 0x20000034,1
mem32 0x2000041C,1
mem32 0x2000043C,22
// speed 300
w1 0x20000400,0x02
w1 0x20000401,0x01
w1 0x20000402,0x00
w1 0x20000407,0x00
w4 0x20000408,0x41FB53D1
g
sleep 3000
h
mem8 0x20000400,4
mem32 0x20000408,1
mem32 0x2000043C,22
mem32 0x20000524,16
g
sleep 4000
h
mem32 0x2000043C,22
mem32 0x20000524,16
// stop
w4 0x20000408,0x00000000
w1 0x20000400,0x00
w1 0x20000401,0x00
g
q
