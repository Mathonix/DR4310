# ═══════════════════════════════════════════════════════════════
# 白名单模式 (Whitelist mode)
# 默认忽略所有文件/目录，只放行下列与开源发布相关的条目。
# Ignore everything by default; only items listed below are
# published to the GitHub repository.
# ═══════════════════════════════════════════════════════════════
/*

# ── 基础 (Basics) ──
!.gitignore
!README.md
!.clangd
!.mxproject

# ── 构建系统 (Build system) ──
!CMakeLists.txt
!CMakePresets.json
!cmake/

# ── STM32CubeMX 工程 ──
!/*.ioc

# ── 源码 (Source code) ──
!Core/
!Libraries/
!Drivers/

# ── 启动/链接文件 (Startup & linker) ──
!startup_stm32g431xx.s
!STM32G431XX_FLASH.ld

# ── 文档 (Docs) ──
!docs/
# 第三方数据手册文本不发布
docs/mt6701_datasheet.txt

# ── 构建产物 (Build artifacts — stay out even inside whitelisted dirs) ──
*.a
*.o
*.elf
*.hex
*.bin
*.map

# Host regression tests for motor control fixes
!tests/
tests/*
!tests/test_control_timing.cpp
!tests/test_motor_safety_regressions.py
!tests/test_rotor_estimator.cpp

# ID-specific firmware and PCAN protocol verification
!tests/test_gm6020_can.cpp
!tools/
tools/*
!tools/build_flash_motor.py
!tools/pcan_gm6020_test.py

# Project Python tool environment
!requirements-tools.txt
