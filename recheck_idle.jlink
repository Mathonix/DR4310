si SWD
device STM32G431KB
speed 1000
connect
h

/* Force IDLE after fresh reset. */
w1 0x200003f0,0x00
w1 0x200003f1,0x00
w1 0x200003f3,0x00
w4 0x20000400,0x00000000
w4 0x200003f8,0x00000000

g
sleep 500
h

mem8 0x200003f0,8
mem32 0x200003f8,4
mem32 0x2000042c,22
mem32 0x200004c4,24
mem32 0x20000590,8
mem32 0x20000630,8
mem16 0x2000048c,4
mem32 0x20000494,2

g
q
