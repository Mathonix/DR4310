si SWD
device STM32G431KB
speed 1000
connect
r
g
sleep 2000
h
// INA240A2 calibrated zero voltages: ia_zero_v, ib_zero_v
mem32 0x20000054,2
// Conversion constants: inv_gain, raw_to_v_scale
mem32 0x2000005C,2
// Latest DMA raw samples: Ia, Ib, Vbus, padding
mem16 0x200006F4,4
// CurrentSense configured, hw_running
mem8 0x200006FC,2
// Runtime current sample: ia, ib, ic, raw_a/raw_b/raw_bus, bus_v
mem32 0x200004A8,6
g
q
