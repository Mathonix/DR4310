si SWD
device STM32G431KB
speed 1000
connect
halt
w4 0x40020008,0x00000000
w4 0x40012408,0x00000000
w4 0x48001418,0x00000001
loadfile build\Debug\4310_G431KBT6.hex
verifybin build\Debug\4310_G431KBT6.bin,0x08000000
r
g
sleep 3000
halt
mem8 0x20000010,4
mem32 0x20000014,1
mem32 0x2000002c,1
mem16 0x200004f4,1
mem8 0x200004f6,1
mem32 0x200004b8,2
mem32 0x20000500,20
mem32 0x200005a4,8
mem16 0x200006d0,4
mem32 0x40020008,4
g
q
