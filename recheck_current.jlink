si SWD
device STM32G431KB
speed 1000
connect
h

/* Force IDLE first. */
w1 0x200003f0,0x00
w1 0x200003f1,0x00
w1 0x200003f3,0x00
w4 0x20000400,0x00000000

/* Start 0.02 A current test. */
w4 0x20000400,0x3CA3D70A
w1 0x200003f0,0x01
w1 0x200003f1,0x01
w1 0x200003f3,0x01

g
sleep 300
h

mem8 0x200003f0,8
mem32 0x200003f8,4
mem32 0x2000042c,22
mem32 0x200004c4,24
mem32 0x20000590,8
mem32 0x20000630,8
mem16 0x2000048c,4
mem32 0x20000494,2

/* Return to IDLE immediately. */
w4 0x20000400,0x00000000
w1 0x200003f0,0x00
w1 0x200003f1,0x00
w1 0x200003f3,0x00

g
sleep 300
h

mem8 0x200003f0,8
mem32 0x2000042c,22
mem32 0x20000590,8

g
q
